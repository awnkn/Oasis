# Manager password for /admin — full access: bookings, capacity,
# insights and accounting. IMPORTANT: change this before going live.
ADMIN_PASSWORD=change-me

# Staff password for /admin — limited access: manage bookings and record
# payments only. IMPORTANT: change this before going live.
STAFF_PASSWORD=staff-change-me

# Optional: secret used to sign admin session cookies.
# If not set, a secret is derived from ADMIN_PASSWORD.
# SESSION_SECRET=some-long-random-string

# Optional: where the SQLite database file lives (defaults to ./data/oasis.db)
# DATABASE_PATH=./data/oasis.db

# Public site URL. Drives every canonical link, Open Graph tag, sitemap
# entry and structured-data URL, so set it to the real domain in production.
# Defaults to https://oasisjo.com.
# SITE_URL=https://oasisjo.com

# --- Automatic guest notifications on approval (both optional) ---

# Email via resend.com: create an API key and verify your sending domain,
# then set the from-address (e.g. bookings@oasisjo.com).
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=bookings@oasisjo.com

# Where the automatic daily database backup is emailed (needs Resend set up).
# BACKUP_EMAIL=rama@amoux.co

# WhatsApp via Meta's Cloud API (developers.facebook.com → WhatsApp):
# needs an approved message template with 5 body variables, in order:
#   {{1}} first name      e.g. Mariam
#   {{2}} reference        e.g. 0198   (the template text supplies the "#")
#   {{3}} date             e.g. Friday, 7 August 2026
#   {{4}} guests           e.g. 2 guests
#   {{5}} total            e.g. 60 JOD
# WHATSAPP_TOKEN=EAAxxxxxxx
# WHATSAPP_PHONE_ID=1234567890
# WHATSAPP_TEMPLATE=booking_confirmed
# WHATSAPP_LANG=en
#
# The day-before reminder is a separate business-initiated message, so it
# needs its own approved template (same 5 variables, in the same order).
# WHATSAPP_REMINDER_TEMPLATE=booking_reminder

# --- Day-before reminders ---
#
# Reminders are sent by /api/cron/reminders. Point a daily scheduler at it
# (Render Cron, cron-job.org, a GitHub Action…) and protect it with this
# secret, sent as "Authorization: Bearer <secret>" or "?key=<secret>".
# As a fallback they also fire from ordinary site traffic, so they still go
# out without a scheduler as long as the site is visited each day.
# CRON_SECRET=some-long-random-string
