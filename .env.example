# Manager password for /admin — full access: bookings, capacity,
# insights and accounting. IMPORTANT: change this before going live.
ADMIN_PASSWORD=change-me

# Staff password for /admin — limited access: manage bookings and record
# payments only. IMPORTANT: change this before going live.
STAFF_PASSWORD=staff-change-me

# Optional: secret used to sign admin session cookies.
# If not set, a secret is derived from ADMIN_PASSWORD.
# SESSION_SECRET=some-long-random-string

# Optional: where the SQLite database file lives (defaults to ./data/oasis.db)
# DATABASE_PATH=./data/oasis.db
