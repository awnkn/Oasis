# Password for the admin dashboard at /admin
# IMPORTANT: change this before going live.
ADMIN_PASSWORD=change-me

# Optional: secret used to sign admin session cookies.
# If not set, a secret is derived from ADMIN_PASSWORD.
# SESSION_SECRET=some-long-random-string

# Optional: where the SQLite database file lives (defaults to ./data/oasis.db)
# DATABASE_PATH=./data/oasis.db
